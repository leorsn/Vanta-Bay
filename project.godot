[application]
config/name="VANTA BAY"
run/main_scene="res://scenes/main.tscn"

[autoload]
StoryBootstrap="*res://scripts/story_bootstrap.gd"
WorldTime="*res://scripts/world_time_manager.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/enable_pause_aware_picking=true

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
phone={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":80)]}
vehicle_accelerate={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]}
vehicle_brake={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]}
vehicle_steer_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]}
vehicle_steer_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]}
vehicle_handbrake={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
